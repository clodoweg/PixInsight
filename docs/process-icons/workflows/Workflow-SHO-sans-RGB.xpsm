      <description>NoiseXTerminator sur O et S sans étoiles, plus bruités : Denoise 0,75 (0,60 à 0,85). Ne pousse pas plus : aspect plastique.</description>
      <parameter id="ml_version" value="0"/>
      <parameter id="denoise" value="0.75"/>
