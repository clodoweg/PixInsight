      <parameter id="coldAutoCheck" value="false"/>
      <parameter id="coldAutoValue" value="3.0"/>
      <parameter id="useDefectList" value="false"/>
      <table id="defects" rows="0"/>
   </instance>
   <instance class="NoOperation" version="256" id="P2_Gradient_instance">
      <description>PHASE 2 — Gradient : image linéaire : retrait du gradient. Colonne de repère, sans effet.</description>
   </instance>
   <instance class="Script" version="256" id="Opt_ImageSolver_seul_instance">
      <description>OPTION — secours : ImageSolver seul, si l'icône ImageSolver (date + ImageSolver) s'arrête après la date.

PRÉRÉGLÉ : ImageSolver 6.4.2 seul (mêmes réglages que l'icône ImageSolver, sans l'ajout de date).

À RÉGLER : secours : glisse sur l'image si l'icône ImageSolver s'arrête après la date.

SI :
- icône bloquée après une mise à jour d'ImageSolver -&gt; efface son champ MD5

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="filePath">$PXI_SRCDIR/scripts/ImageSolver/ImageSolver.js</parameter>
      <parameter id="md5sum"></parameter>
