            <td id="value">NoiseXterminator</td>
         </tr>
         <tr>
            <td id="id">starrySelected</td>
            <td id="value">true</td>
         </tr>
         <tr>
            <td id="id">outputLinearImageOnly</td>
            <td id="value">true</td>
         </tr>
         <tr>
            <td id="id">aiModel</td>
            <td id="value">2.0.0</td>
         </tr>
      </table>
      <parameter id="information"></parameter>
   </instance>
   <instance class="PixelMath" version="256" id="Opt_H_dans_L_instance">
      <description>OPTION — régions HII plus nettes (H injecté dans la luminance).

PRÉRÉGLÉ : a = 1,0 ; L = max(L, a·H_cs), sur L elle-même.

À RÉGLER : glisse sur L ; H_cs doit exister.

SI :
- couleurs délavées -&gt; baisse a

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="expression">a = 1.0;
max($T, H_cs*a)</parameter>
      <parameter id="expression1"></parameter>
      <parameter id="expression2"></parameter>
      <parameter id="expression3"></parameter>
      <parameter id="useSingleExpression" value="true"/>
      <parameter id="symbols">a</parameter>
      <parameter id="clearImageCacheAndExit" value="false"/>
      <parameter id="cacheGeneratedImages" value="false"/>
      <parameter id="generateOutput" value="true"/>
