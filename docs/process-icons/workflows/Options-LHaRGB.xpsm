         </tr>
         <tr>
            <td id="id">generatePreview</td>
            <td id="value">true</td>
         </tr>
         <tr>
            <td id="id">previewName</td>
            <td id="value">Background</td>
         </tr>
         <tr>
            <td id="id">slowSearch</td>
            <td id="value">false</td>
         </tr>
         <tr>
            <td id="id">fastSearch</td>
