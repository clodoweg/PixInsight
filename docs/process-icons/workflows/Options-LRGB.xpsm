      <parameter id="structureName"></parameter>
      <parameter id="structureSize" value="5"/>
      <table id="structureWayTable" rows="1">
         <tr>
            <td id="mask">0x00,0x01,0x01,0x01,0x00,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x01,0x00,0x01,0x01,0x01,0x00</td>
