            </tr>
            <tr>
               <td id="id">flou</td>
               <td id="value">2</td>
            </tr>
            <tr>
               <td id="id">nom</td>
               <td id="value">masque_L</td>
            </tr>
            <tr>
               <td id="id">dialogue</td>
               <td id="value">false</td>
            </tr>
         </table>
         <parameter id="information"></parameter>
      </instance>
      <instance class="UnsharpMask" version="256" enabled="true">
         <parameter id="sigma" value="2.00"/>
         <parameter id="amount" value="0.30"/>
         <parameter id="useLuminance" value="true"/>
