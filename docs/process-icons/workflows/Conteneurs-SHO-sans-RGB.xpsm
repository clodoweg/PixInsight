            <td id="value">7</td>
         </tr>
         <tr>
            <td id="id">seuil</td>
            <td id="value">0.15</td>
         </tr>
         <tr>
            <td id="id">etendue</td>
            <td id="value">12</td>
         </tr>
         <tr>
