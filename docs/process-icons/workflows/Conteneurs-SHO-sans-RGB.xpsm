   <instance class="NarrowbandNormalization" version="256" id="E17_NBN_SHO_instance">
      <description>PRÉRÉGLÉ : palette SHO, Lightness = Ha (H porte le détail), SCNR 0,7 (vert retiré en partie) (demandes de l'utilisateur) ; O3 boost, S2 boost, Brightness, Highlight reduction à 1 (neutres : ce sont des multiplicateurs, 0 rend l'image noire) ; Shadow point 1 (normalisation à partir de la médiane).&#10;&#10;À RÉGLER : glisse sur SHO_etire (SHO_simple) ; O3 puis S2 boost au-dessus de 1, peu à peu ; Shadow point : 1 = normalisation à partir de la médiane, vers 0 = zones faibles aussi (plus de bruit).&#10;&#10;SI :&#10;- trop vert -&gt; SCNR partiel&#10;- O discret -&gt; O3 boost</description>
      <parameter id="palette" value="Palette_SHO"/>
      <parameter id="lightness" value="Lightness_Ha"/>
      <parameter id="blendMode" value="Blend_Mode1"/>
      <parameter id="haBlend" value="0.000"/>
      <parameter id="scnr" value="0.700"/>
      <parameter id="o3Boost" value="1.000"/>
      <parameter id="s2Boost" value="1.000"/>
      <parameter id="shadowpoint" value="1.000"/>
      <parameter id="highlightReduction" value="1.000"/>
      <parameter id="brightness" value="1.000"/>
   </instance>
