   <instance class="PixelMath" version="256" id="Opt_Etoiles_HOO_synth_instance">
      <description>OPTION — alternative à NB to RGB pour les étoiles.&#10;&#10;PRÉRÉGLÉ : R = H_stars, G = 0,2·H_stars + 0,8·O_stars, B = O_stars.&#10;&#10;À RÉGLER : vues d'étoiles linéaires H_stars et O_stars.&#10;&#10;SI :&#10;- étoiles bleues verdâtres -&gt; 0,3·H + 0,7·O</description>
      <parameter id="expression">H_stars</parameter>
      <parameter id="expression1">0.2*H_stars + 0.8*O_stars</parameter>
      <parameter id="expression2">O_stars</parameter>
      <parameter id="expression3"></parameter>
