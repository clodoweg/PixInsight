      <parameter id="scaleFactorB" value="1.00"/>
      <parameter id="showGradientModel" value="true"/>
   </instance>
   <instance class="DynamicBackgroundExtraction" version="1" id="Opt_DBE_instance">
      <description>ALTERNATIVE — DBE.&#10;&#10;PRÉRÉGLÉ : 15 points par ligne, rayon 15, Tolerance 0,5, Smoothing 0,25, Subtraction.&#10;&#10;À RÉGLER : Generate, retire les points sur l'objet, ajoute-en dans le fond vide.&#10;&#10;SI :&#10;- points rouges -&gt; Tolerance 1,0 à 1,5&#10;- vignettage -&gt; Division</description>
      <table id="data" rows="0"/>
