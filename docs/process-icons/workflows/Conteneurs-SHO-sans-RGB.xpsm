   <instance class="GeneralizedHyperbolicStretch" version="256" id="E13_GHS_1_premier_instance">
      <description>PRÉRÉGLÉ : b = 10, Stretch factor 0.&#10;&#10;À RÉGLER : étire H d'abord (pic à 0,25 ; Stretch factor 3,5 à 6,5 selon le fond lu), puis O et S jusqu'au MÊME fond (Stretch factor plus élevé).&#10;&#10;SI :&#10;- bruit de O ou S qui ressort -&gt; SP trop bas, remonte-le</description>
      <parameter id="stretchType" value="ST_GeneralisedHyperbolic"/>
      <parameter id="stretchChannel" value="SC_RGB"/>
      <parameter id="inverse" value="false"/>
      <parameter id="stretchFactor" value="0.000"/>
