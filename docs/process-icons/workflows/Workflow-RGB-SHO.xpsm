   <instance class="BlurXTerminator" version="256" id="RSHO_31_BXT_CorrectOnly_instance">
      <description>BlurXTerminator — Correct Only, AVANT SPCC (manuel RC Astro) : corrige aberrations, coma et tilt sans accentuer. Sur l'image couleur combinée, en linéaire, après le gradient. Si les aberrations diffèrent d'un filtre à l'autre : applique-le sur chaque master avant de combiner.</description>
      <parameter id="ml_version" value="4"/>
      <parameter id="correct_only" value="true"/>
      <parameter id="sharpen_stars" value="0.25"/>
      <parameter id="adjust_star_halos" value="0.00"/>
      <parameter id="nonstellar_diameter" value="0.0"/>
      <parameter id="auto_nonstellar_psf" value="true"/>
      <parameter id="sharpen_nonstellar" value="0.50"/>
      <parameter id="lunar_planetary" value="false"/>
      <parameter id="overlap" value="0.20"/>
   </instance>
