      <parameter id="psfNoiseLayers" value="1"/>
      <parameter id="psfHotPixelFilterRadius" value="1"/>
      <parameter id="psfNoiseReductionFilterRadius" value="0"/>
      <parameter id="psfMinStructureSize" value="0"/>
      <parameter id="psfMinSNR" value="40.00"/>
      <parameter id="psfAllowClusteredSources" value="true"/>
      <parameter id="psfType" value="PSFType_Auto"/>
      <parameter id="psfGrowth" value="1.25"/>
      <parameter id="psfMaxStars" value="24576"/>
      <parameter id="psfSearchTolerance" value="4.00"/>
      <parameter id="psfChannelSearchTolerance" value="2.00"/>
      <parameter id="neutralizeBackground" value="true"/>
      <parameter id="backgroundReferenceViewId"></parameter>
      <parameter id="backgroundLow" value="-2.80"/>
      <parameter id="backgroundHigh" value="2.00"/>
      <parameter id="backgroundUseROI" value="false"/>
      <parameter id="backgroundROIX0" value="0"/>
      <parameter id="backgroundROIY0" value="0"/>
      <parameter id="backgroundROIX1" value="0"/>
      <parameter id="backgroundROIY1" value="0"/>
      <parameter id="generateGraphs" value="true"/>
      <parameter id="generateStarMaps" value="false"/>
      <parameter id="generateTextFiles" value="false"/>
      <parameter id="outputDirectory"></parameter>
   </instance>
   <instance class="BlurXTerminator" version="256" id="E29_BXT_RGB_instance">
      <description>PRÉRÉGLÉ : Sharpen Stars 0,25, Halos 0, Nonstellar 0,50, PSF auto.

À RÉGLER : rien ; après SPCC, en linéaire.

SI :
- vers ou pores à 100 % -&gt; Nonstellar 0,40
- halos sombres -&gt; Sharpen Stars plus bas ou Halos plus haut

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="ml_version" value="4"/>
      <parameter id="correct_only" value="false"/>
      <parameter id="sharpen_stars" value="0.25"/>
      <parameter id="adjust_star_halos" value="0.00"/>
      <parameter id="nonstellar_diameter" value="0.0"/>
      <parameter id="auto_nonstellar_psf" value="true"/>
      <parameter id="sharpen_nonstellar" value="0.50"/>
      <parameter id="lunar_planetary" value="false"/>
      <parameter id="overlap" value="0.20"/>
   </instance>
   <instance class="StarXTerminator" version="256" id="E30_SXT_RGB_lineaire_instance">
      <description>PRÉRÉGLÉ : Generate star image coché, Unscreen décoché.

À RÉGLER : rien ; sur le RGB linéaire calibré ; garde seulement l'image d'étoiles.

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="ml_version" value="0"/>
      <parameter id="output_stars" value="true"/>
      <parameter id="unscreen" value="false"/>
      <parameter id="remove_stars" value="true"/>
      <parameter id="remove_spikes" value="true"/>
      <parameter id="remove_aureoles" value="true"/>
      <parameter id="remove_reflections" value="false"/>
      <parameter id="overlap" value="0.20"/>
   </instance>
   <instance class="Script" version="256" id="E31_Star_Stretch_instance">
      <description>LANCEMENT : glisse l'icône sur l'image. Si l'icône est bloquée après une mise à jour du script, efface son champ MD5.

PRÉRÉGLÉ : Stretch Amount 5, Color Boost 1,0, SCNR décoché.

À RÉGLER : rien ; sur l'image d'étoiles linéaire.

SI :
- étoiles trop grosses -&gt; 4
- couleurs criardes -&gt; Color Boost 0,7

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="filePath">$PXI_SRCDIR/scripts/star_stretch.js</parameter>
      <parameter id="md5sum">69a1ee6db4e9f5374c2cddb1e5a7f4ae</parameter>
      <table id="parameters" rows="4">
         <tr>
            <td id="id">amount</td>
            <td id="value">5</td>
         </tr>
         <tr>
            <td id="id">satAmount</td>
            <td id="value">1</td>
         </tr>
         <tr>
            <td id="id">removeGreen</td>
            <td id="value">false</td>
         </tr>
         <tr>
            <td id="id">showPreview</td>
            <td id="value">false</td>
         </tr>
      </table>
      <parameter id="information"></parameter>
   </instance>
   <instance class="PixelMath" version="256" id="E32_Etoiles_screen_instance">
      <description>PRÉRÉGLÉ : ~((~starless) * (~stars)), image 'Final'.

À RÉGLER : nomme l'image sans étoiles 'starless' et les étoiles 'stars', toutes deux étirées.

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="expression">~((~starless) * (~stars))</parameter>
      <parameter id="expression1"></parameter>
      <parameter id="expression2"></parameter>
      <parameter id="expression3"></parameter>
      <parameter id="useSingleExpression" value="true"/>
      <parameter id="symbols"></parameter>
      <parameter id="clearImageCacheAndExit" value="false"/>
      <parameter id="cacheGeneratedImages" value="false"/>
      <parameter id="generateOutput" value="true"/>
      <parameter id="singleThreaded" value="false"/>
      <parameter id="optimization" value="true"/>
      <parameter id="use64BitWorkingImage" value="false"/>
      <parameter id="rescale" value="false"/>
      <parameter id="rescaleLower" value="0"/>
      <parameter id="rescaleUpper" value="1"/>
      <parameter id="truncate" value="true"/>
      <parameter id="truncateLower" value="0"/>
      <parameter id="truncateUpper" value="1"/>
      <parameter id="createNewImage" value="true"/>
      <parameter id="showNewImage" value="true"/>
      <parameter id="newImageId">Final</parameter>
      <parameter id="newImageWidth" value="0"/>
      <parameter id="newImageHeight" value="0"/>
      <parameter id="newImageAlpha" value="false"/>
      <parameter id="newImageColorSpace" value="SameAsTarget"/>
      <parameter id="newImageSampleFormat" value="SameAsTarget"/>
      <table id="outputData" rows="0"/>
   </instance>
   <instance class="PixelMath" version="256" id="E33_Blanshan_Transfer_instance">
      <description>PRÉRÉGLÉ : S = 0,15.

À RÉGLER : vue sans étoiles nommée 'starless' ; glisse sur l'image avec étoiles.

SI :
- étoiles encore grosses -&gt; S plus bas

Détails : page docs/pixinsight-workflow.html.</description>
      <parameter id="expression">S=0.15;
Img1=starless;
f1= ~((~mtf(~S,$T)/~mtf(~S,Img1))*~Img1);
max(Img1,f1)</parameter>
      <parameter id="expression1"></parameter>
      <parameter id="expression2"></parameter>
      <parameter id="expression3"></parameter>
      <parameter id="useSingleExpression" value="true"/>
      <parameter id="symbols">S, Img1, f1</parameter>
      <parameter id="clearImageCacheAndExit" value="false"/>
      <parameter id="cacheGeneratedImages" value="false"/>
      <parameter id="generateOutput" value="true"/>
      <parameter id="singleThreaded" value="false"/>
      <parameter id="optimization" value="true"/>
      <parameter id="use64BitWorkingImage" value="false"/>
      <parameter id="rescale" value="false"/>
      <parameter id="rescaleLower" value="0"/>
      <parameter id="rescaleUpper" value="1"/>
      <parameter id="truncate" value="true"/>
      <parameter id="truncateLower" value="0"/>
      <parameter id="truncateUpper" value="1"/>
      <parameter id="createNewImage" value="false"/>
      <parameter id="showNewImage" value="true"/>
      <parameter id="newImageId"></parameter>
      <parameter id="newImageWidth" value="0"/>
      <parameter id="newImageHeight" value="0"/>
      <parameter id="newImageAlpha" value="false"/>
      <parameter id="newImageColorSpace" value="SameAsTarget"/>
      <parameter id="newImageSampleFormat" value="SameAsTarget"/>
      <table id="outputData" rows="0"/>
   </instance>
