   <instance class="NoiseXTerminator" version="256" id="HOO_19_NXT_OIII_SII_instance">
      <description>NoiseXTerminator sur OIII et SII sans étoiles, plus bruités : Denoise 0,75 (0,60 à 0,85). Ne pousse pas plus : aspect plastique.</description>
      <parameter id="ml_version" value="0"/>
      <parameter id="denoise" value="0.75"/>
      <parameter id="enable_color_separation" value="false"/>
